# Normalize line endings in the repository; preserve CRLF for Windows scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep the lockfile out of GitHub's language statistics, but leave it diffable:
# a `-diff` attribute makes git treat it as binary, so `git grep` silently
# skips it — including in a secret scan.
package-lock.json linguist-generated
