{
  "name": "@coldcanuk/dsh-web-search-brave",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Brave Search provider for the DeepSeek Harness web capability seam (ctx.web): agent-oriented LLM Context and results-page Web Search, keyed by the Brave Search API.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Chuck <chuck@actvite.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldcanuk/deepseek_brave_plugin.git"
  },
  "homepage": "https://github.com/coldcanuk/deepseek_brave_plugin#readme",
  "bugs": {
    "url": "https://github.com/coldcanuk/deepseek_brave_plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "brave-search",
    "brave-search-api",
    "web-search",
    "search-provider",
    "llm-context",
    "cordis",
    "cordis-plugin",
    "plugin",
    "ai-agents",
    "llm-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/check-test-gate.mjs",
    "test:raw": "node --test",
    "test:coverage": "node scripts/check-coverage.mjs --report",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:test-gate": "node scripts/check-test-gate.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:types:tsc": "tsc --project tsconfig.json",
    "check:lint": "biome lint --error-on-warnings .",
    "check": "npm run check:secrets && npm run check:lint && npm run check:types && npm run check:types:tsc && npm test && npm run check:coverage"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
