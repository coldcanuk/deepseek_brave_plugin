# dsh-web-search-brave — placeholder template.
#
# Copy to .env (which is gitignored) and fill in locally, or export these in the
# environment that launches the harness. NEVER commit a real value here: this
# file is tracked, and .env.example must stay a template.
#
# The key is read at search time from the harness credential service or the
# launch environment, travels only in the X-Subscription-Token request header,
# and is never logged.

# Brave Search API subscription token.
BRAVE_SEARCH_API_KEY=your-key-here

# Optional: override the API base. Useful for a local mock or an allowlisted
# proxy. Defaults to https://api.search.brave.com/res/v1
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
